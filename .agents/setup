#!/usr/bin/env bash
# Prepares a fresh Amp orb: Bun toolchain and workspace dependencies.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local label="$1"
  shift
  local start=$SECONDS
  echo "==> $label"
  "$@"
  echo "<== $label ($((SECONDS - start))s)"
}

# package.json requires bun >=1.3.1; the orb base image usually ships a newer one.
ensure_bun() {
  if command -v bun >/dev/null 2>&1; then
    echo "bun $(bun --version) already installed"
    return
  fi
  curl -fsSL https://bun.sh/install | bash -s "bun-v1.3.1"
}

step "bun" ensure_bun
export PATH="$HOME/.bun/bin:$PATH"

# Also runs husky (prepare) and fumadocs-mdx (apps/ui postinstall).
step "bun install" bun install --frozen-lockfile
